[Unit]
Description=SearXNG metasearch (hermes-searxng plugin backend)
Documentation=https://github.com/searxng/searxng
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# USER unit: the Hermes plugin runs as this user and the install needs no root.
# `loginctl enable-linger` is already on (see survive.sh step 4), so this starts
# at boot without an interactive login.
WorkingDirectory=%h/searxng/searxng-src
Environment=SEARXNG_SETTINGS_PATH=%h/searxng/searxng-src/searx/settings.yml
# Resolve the interpreter AT START, never bake it in. The PM runtime venv is
# keyed by a hash that changes whenever Hermes rebuilds its dependency
# generation, so a hardcoded path keeps running until the first restart and then
# fails forever with ModuleNotFoundError — enabled service, dead port, and every
# searxng_* tool silently returning nothing. The runner also (re)installs
# SearXNG's requirements into whatever interpreter it resolves.
ExecStart=%h/hermes-ultimate-coding/tools/searxng-run.sh
Restart=on-failure
RestartSec=5
# Never let a crash-loop permanently stop the unit (a stopped unit means the
# searxng plugin silently degrades to "no results" for every query).
StartLimitIntervalSec=0
StartLimitBurst=0

[Install]
WantedBy=default.target
