diff --git a/tests/hermes_cli/test_toolset_validation_plugin_keys.py b/tests/hermes_cli/test_toolset_validation_plugin_keys.py
new file mode 100644
index 0000000000..37dfc6e1af
--- /dev/null
+++ b/tests/hermes_cli/test_toolset_validation_plugin_keys.py
@@ -0,0 +1,75 @@
+"""Regression: the ``platform_toolsets`` validator must resolve plugin-toolset VALIDITY through the
+authoritative (blocking) reader.
+
+Plugin discovery runs on a background thread that overlaps CLI startup and the post-update config
+migration. Judging a saved name by the NON-blocking reader (last launch's persisted key cache) while
+a plugin's ``register()`` has not run yet reports every toolset it owns as an unknown name — which
+surfaced as four false warnings on `hermes update` for plugins whose ``register()`` installs a JIT
+dependency (discovery is still importing when the migration runs). A genuine typo must still warn.
+"""
+
+import pytest
+
+import hermes_cli.plugins as plugins_mod
+from hermes_cli import toolset_validation
+from hermes_cli.toolset_validation import saved_toolset_resolver, validate_platform_toolsets
+
+
+@pytest.fixture(autouse=True)
+def _clear_resolver_caches():
+    # ``saved_toolset_resolver`` memoises plugin_names()/platform_bundles() per resolver instance via
+    # functools.cache on nested closures; a fresh resolver per test is enough, but clear the
+    # module-level caches the import touches too so a previous test cannot leak state.
+    yield
+
+
+def _resolver(monkeypatch, *, authoritative, stale):
+    monkeypatch.setattr(plugins_mod, "get_plugin_toolset_keys", lambda *a, **k: set(authoritative), raising=False)
+    monkeypatch.setattr(plugins_mod, "get_plugin_toolset_keys_nowait", lambda *a, **k: set(stale), raising=False)
+    monkeypatch.setattr(plugins_mod, "get_portable_mcp_server_names_nowait", lambda: set(), raising=False)
+    monkeypatch.setattr(toolset_validation, "_platform_plugin_manifests_stub", None, raising=False)
+    return saved_toolset_resolver({})
+
+
+def test_validator_ignores_the_stale_nowait_keys(monkeypatch):
+    """A plugin toolset missing from the stale cache is NOT an unknown name when discovery knows it."""
+    cfg = {"cli": ["graphify", "semble", "codegraph"]}
+    monkeypatch.setattr(toolset_validation, "toolset_allowed_for_platform", lambda *a, **k: True,
+                        raising=False)
+    resolver = _resolver(monkeypatch, authoritative={"graphify", "semble", "codegraph"}, stale={"codegraph"})
+
+    warnings = validate_platform_toolsets(cfg, resolver, is_allowed_for_platform=lambda *a, **k: True)
+    assert not any("unknown toolset" in w for w in warnings), warnings
+
+
+def test_validator_still_reports_a_genuine_typo(monkeypatch):
+    cfg = {"cli": ["codegraph", "totally_bogus_typo"]}
+    resolver = _resolver(monkeypatch, authoritative={"graphify", "semble", "codegraph"}, stale={"codegraph"})
+
+    warnings = validate_platform_toolsets(cfg, resolver, is_allowed_for_platform=lambda *a, **k: True)
+    assert any("unknown toolset 'totally_bogus_typo'" in w for w in warnings), warnings
+    assert not any("'codegraph'" in w for w in warnings), warnings
+
+
+def test_resolver_prefers_the_authoritative_reader(monkeypatch):
+    """Directly pin the wiring: the resolver's plugin-name set comes from the blocking reader."""
+    resolver = _resolver(monkeypatch, authoritative={"only_authoritative"}, stale={"only_stale"})
+    assert resolver("only_authoritative") is True
+    assert resolver("only_stale") is False
+
+
+def test_blocking_reader_falls_back_when_discovery_yields_nothing(monkeypatch):
+    """A config-only host (no plugins installed) must not see an empty authoritative set wipe a
+    persisted one — the fallback keeps the nowait answer."""
+    class _Mgr:
+        _discovered = True
+
+    def _no_join(**_kwargs):
+        return None
+
+    monkeypatch.setattr(plugins_mod, "get_plugin_manager", lambda: _Mgr())
+    monkeypatch.setattr(plugins_mod, "get_plugin_toolsets", list)
+    monkeypatch.setattr(plugins_mod, "get_plugin_toolset_keys_nowait", lambda: {"persisted_only"})
+    monkeypatch.setattr(plugins_mod, "_join_background_discovery", _no_join)
+
+    assert plugins_mod.get_plugin_toolset_keys() == {"persisted_only"}
