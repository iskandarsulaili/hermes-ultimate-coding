--- a/hermes_cli/plugins.py
+++ b/hermes_cli/plugins.py
@@ -1816,7 +1816,11 @@ def _persist_plugin_toolset_keys() -> None:
 
 
 def _nowait_plugin_set(cache_field: str, live: Callable[[PluginManager], "set[str]"]) -> "set[str]":
-    """Shared body of the ``*_nowait`` probes: live registry, else last launch's cache, else block."""
+    """Shared body of the ``*_nowait`` probes: live registry, else last launch's cache, else block.
+
+    A stale/partial answer is only acceptable for callers that EXCLUDE these names (filtering a
+    candidate list), where a miss self-heals. A caller that treats membership as VALIDITY must use the
+    blocking :func:`get_plugin_toolset_keys` instead — see its docstring."""
     manager = get_plugin_manager()
     t = _background_discovery_thread
     in_flight = t is not None and t.is_alive()
@@ -1834,11 +1838,37 @@ def _nowait_plugin_set(cache_field: str, live: Callable[[PluginManager], "set[st
 
 def get_plugin_toolset_keys_nowait() -> "set[str]":
     """Plugin toolset keys without blocking on in-flight discovery: live registry when done, last
-    launch's persisted set while a background scan runs (callers only EXCLUDE these keys, so a stale
-    set is harmless and self-heals), else block via discover_plugins()."""
+    launch's persisted set while a background scan runs, else block via discover_plugins().
+
+    ONLY for callers that EXCLUDE these keys (e.g. filtering a "did you mean" candidate list), where a
+    stale/partial set is harmless and self-heals. A caller that treats membership as *validity* (an
+    inclusion decision, like the ``platform_toolsets`` validator) must use
+    :func:`get_plugin_toolset_keys` instead: during an in-flight scan this can still be missing a
+    plugin whose ``register()`` has not run yet, so every toolset it owns would look unknown while
+    loading, and the persisted copy can be stale for the same reason."""
     return _nowait_plugin_set("toolset_keys", lambda _m: {ts_key for ts_key, _, _ in get_plugin_toolsets()})
 
 
+def get_plugin_toolset_keys(timeout: float = 30.0) -> "set[str]":
+    """Authoritative plugin toolset keys, for callers making an *inclusion* decision.
+
+    Joins an in-flight background discovery (bounded by ``timeout``) so the registry is as complete
+    as discovery can make it before the keys are read. Reading the non-blocking set while plugins are
+    still registering reports their toolsets as unknown, which surfaced as false ``platform_toolsets``
+    warnings right after an update (plugin discovery of the two JIT-dependency installers overlaps the
+    config migration). Falls back to the persisted/partial set when discovery yields nothing (no
+    plugins installed, or discovery failed), so a config-only host never sees an empty verdict."""
+    _join_background_discovery(timeout=timeout)
+    manager = get_plugin_manager()
+    if not manager._discovered:
+        try:
+            manager.discover_and_load()
+        except Exception:
+            logger.debug("plugin discovery during toolset-key read failed", exc_info=True)
+    keys = {ts_key for ts_key, _, _ in get_plugin_toolsets()}
+    return keys or get_plugin_toolset_keys_nowait()
+
+
 def get_portable_mcp_server_names_nowait() -> "set[str]":
     """Portable MCP server names; same contract as :func:`get_plugin_toolset_keys_nowait`."""
     return _nowait_plugin_set("portable_mcp", lambda m: set(m.get_portable_mcp_servers()))
diff --git a/hermes_cli/tools_config.py b/hermes_cli/tools_config.py
