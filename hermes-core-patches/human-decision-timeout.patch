+def human_confirm_timeout() -> int:
+    """Seconds to wait for a human DECISION rather than a command approval — slash-command
+    confirms, expensive-model-switch confirms, secret/vault prompts, one-time codes.
+
+    Deliberately the SAME knob as command approvals (``approvals.timeout``): an operator who says
+    "wait 24h for my answer" means every surface that is parked on them, not just the dangerous-
+    command prompt. Previously these surfaces each hardcoded their own short wait (120s modal,
+    45s sudo, 120/180s vault, 300s gateway confirm), so a decision the user stepped away from
+    silently evaporated well before the configured approval window. ``<= 0`` = unlimited.
+    """
+    return _get_approval_timeout()
+
+
