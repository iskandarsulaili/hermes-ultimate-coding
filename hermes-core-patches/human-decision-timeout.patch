@@ -0,0 +1,119 @@
+"""One knob for every human DECISION wait (answer / confirmation / permission).
+
+Regression guard: the surfaces parked on the operator — the clarify question, the command
+approval, the slash-command confirm, the model-switch warning, sudo/vault secret prompts —
+must all resolve their wait from the SAME setting (``approvals.timeout``), so configuring a
+long window (e.g. 24h) actually means 24h everywhere instead of a hardcoded 45/120/180/300s
+silently cancelling the prompt the user stepped away from.
+"""
+
+from __future__ import annotations
+
+import time
+
+import pytest
+
+from tools import approval_context
+from tools import slash_confirm
+
+
+def _set_timeout(monkeypatch, value):
+    monkeypatch.setattr(approval_context, "_get_approval_config", lambda: {"timeout": value})
+
+
+def test_human_confirm_timeout_tracks_approvals_timeout(monkeypatch):
+    _set_timeout(monkeypatch, 86400)
+    assert approval_context.human_confirm_timeout() == 86400
+    _set_timeout(monkeypatch, 300)
+    assert approval_context.human_confirm_timeout() == 300
+
+
+def test_human_confirm_timeout_honours_unlimited(monkeypatch):
+    """``<= 0`` is the documented unlimited escape hatch and must survive verbatim."""
+    _set_timeout(monkeypatch, 0)
+    assert approval_context.human_confirm_timeout() == 0
+    _set_timeout(monkeypatch, -1)
+    assert approval_context.human_confirm_timeout() == -1
+
+
+def test_human_confirm_timeout_is_platform_safe_capped(monkeypatch):
+    """A huge value must be clamped, never passed raw into Lock.acquire/Thread.join."""
+    from agent.deadline import MAX_SAFE_TIMEOUT_S
+
+    _set_timeout(monkeypatch, int(MAX_SAFE_TIMEOUT_S) * 10)
+    assert approval_context.human_confirm_timeout() == int(MAX_SAFE_TIMEOUT_S)
+
+
+def test_slash_confirm_timeout_uses_live_approvals_timeout(monkeypatch):
+    _set_timeout(monkeypatch, 86400)
+    assert slash_confirm.resolve_timeout() == 86400.0
+
+
+def test_slash_confirm_falls_back_when_config_unreadable(monkeypatch):
+    def boom():
+        raise RuntimeError("config unavailable")
+
+    monkeypatch.setattr(approval_context, "_get_approval_config", boom)
+    assert slash_confirm.resolve_timeout() == float(slash_confirm.DEFAULT_TIMEOUT_SECONDS)
+
+
+def test_pending_confirm_survives_past_the_old_300s_window(monkeypatch):
+    """A confirm registered an hour ago is still resolvable under a 24h window (and was NOT
+    under the old hardcoded 300s default — the defect this guards)."""
+    _set_timeout(monkeypatch, 86400)
+    slash_confirm.register("sess", "cid-1", "reload-mcp", handler=None)
+    with slash_confirm._lock:
+        slash_confirm._pending["sess"]["created_at"] = time.time() - 3600
+
+    assert slash_confirm.clear_if_stale("sess") is False
+    assert slash_confirm.get_pending("sess") is not None
+
+    _set_timeout(monkeypatch, 300)
+    assert slash_confirm.clear_if_stale("sess") is True
+    assert slash_confirm.get_pending("sess") is None
+
+
+@pytest.mark.asyncio
+async def test_resolve_runs_handler_for_a_late_button_tap(monkeypatch):
+    """The button tapped hours later must still run the handler (not read as stale)."""
+    _set_timeout(monkeypatch, 86400)
+
+    async def handler(choice):
+        return f"ran:{choice}"
+
+    slash_confirm.register("sess", "cid-2", "reload-mcp", handler=handler)
+    with slash_confirm._lock:
+        slash_confirm._pending["sess"]["created_at"] = time.time() - 7200
+
+    assert await slash_confirm.resolve("sess", "cid-2", "once") == "ran:once"
+
+
+@pytest.mark.asyncio
+async def test_resolve_expires_a_late_button_tap_under_a_short_window(monkeypatch):
+    _set_timeout(monkeypatch, 300)
+
+    async def handler(choice):  # pragma: no cover - must not run
+        return "ran"
+
+    slash_confirm.register("sess", "cid-3", "reload-mcp", handler=handler)
+    with slash_confirm._lock:
+        slash_confirm._pending["sess"]["created_at"] = time.time() - 7200
+
+    assert await slash_confirm.resolve("sess", "cid-3", "once") is None
+
+
+def test_cli_modal_wait_tracks_approvals_timeout(monkeypatch):
+    from hermes_cli.cli_modal_mixin import _confirm_wait_seconds
+
+    _set_timeout(monkeypatch, 86400)
+    assert _confirm_wait_seconds() == 86400.0
+
+
+def test_cli_modal_wait_falls_back_to_120s(monkeypatch):
+    from hermes_cli.cli_modal_mixin import _confirm_wait_seconds
+
+    def boom():
+        raise RuntimeError("no config")
+
+    monkeypatch.setattr(approval_context, "_get_approval_config", boom)
+    assert _confirm_wait_seconds() == 120.0
